# Neon PostgreSQL connection string (required by Vercel Functions and migrations)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Private Vercel Blob store read/write token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Resend
RESEND_API_KEY=re_example
EMAIL_FROM=Love Story <story@example.com>

# Exact browser origin; do not include a trailing slash
APP_ORIGIN=http://localhost:5173

# Long random value also configured for the Vercel Cron request
CRON_SECRET=replace-with-a-long-random-secret
